# Copy to .env and fill in. NEVER commit .env.
# Only the most-used settings are listed; every setting lives in app/core/config.py.

# --- which market this app serves: US (this repo) | IN (India repo) ---
APP_MARKET=US

# --- database (docker-compose.yml: stock-postgres on port 5433) ---
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=stockmarket
DATABASE_USER=stockuser
DATABASE_PASSWORD=

# --- secrets ---
JWT_SECRET_KEY=
BROKER_ENCRYPTION_KEY=
JOB_TRIGGER_TOKEN=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_DATA_FEED=iex

# --- safety switches (paper only; keep LIVE false) ---
TRADING_ENABLED=true
PAPER_TRADING_ENABLED=true
AUTO_TRADING_ENABLED=true
LIVE_TRADING_ENABLED=false

# --- scheduler: sync -> scan -> orders -> exits every 15 min in market hours ---
LOCAL_SCHEDULER_ENABLED=true
LOCAL_SCHEDULER_INTERVAL_MINUTES=15

# --- sizing ---
ACCOUNT_SIZE=10000
RISK_PERCENT=1.0
MAX_POSITION_PERCENT=20

# --- strategy ---
ENTRY_MODE=BOTH
RISK_MODEL=ATR_FLOOR
RISK_MIN_STOP_ATR=1.0
BOUNCE_MIN_RR=1.5
# experimental, off until backtested (app/backtest/compare_bounce.py)
BOUNCE_LEVEL_ZONE_ATR=0.0
BOUNCE_CONFIRM_BARS=1

# --- live 1-minute entries ---
LIVE_BOUNCE_ENABLED=true
LIVE_BOUNCE_BAR_MINUTES=5
LIVE_STREAM_MAX_SYMBOLS=30
LIVE_PRICE_CHECK_ENABLED=true
MAX_AUTO_ENTRIES_PER_SYMBOL_PER_DAY=1
EARLY_ALERTS_ENABLED=false

# --- market & sector guards ---
MARKET_FILTER_ENABLED=true
MARKET_FILTER_MAX_DAY_DROP_PCT=1.0
MARKET_FILTER_MAX_FROM_OPEN_DROP_PCT=0.6
MAX_OPEN_POSITIONS_PER_SECTOR=2

# --- holdings guard (trailing stop on part of holdings, buy back at support) ---
HOLDINGS_GUARD_ENABLED=false
HOLDINGS_GUARD_SYMBOLS=
HOLDINGS_GUARD_TRADE_PCT=40
