FROM node:24-slim AS dashboard
WORKDIR /ui
COPY stock-market-ui/package.json stock-market-ui/package-lock.json ./
RUN npm ci --ignore-scripts
COPY stock-market-ui/ ./
RUN npm run build

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PORT=8080
WORKDIR /app
COPY stock-market-backend/requirements-cloud.txt ./
RUN pip install --no-cache-dir -r requirements-cloud.txt
COPY stock-market-backend/app ./app
COPY stock-market-backend/alembic ./alembic
COPY stock-market-backend/alembic.ini ./
COPY --from=dashboard /ui/dist ./ui
RUN useradd --uid 10001 --create-home appuser
USER appuser
CMD ["sh", "-c", "exec uvicorn app.cloud_main:app --host 0.0.0.0 --port ${PORT:-8080} --workers 1"]
